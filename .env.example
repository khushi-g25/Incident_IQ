# ---- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
TRIAGE_MODEL=sonnet                 # opus for the hard tickets
TRIAGE_MAX_TURNS=40
TRIAGE_MAX_BUDGET_USD=2.00

# ---- Jira ------------------------------------------------------------------
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=svc-triage@yourcompany.com
JIRA_API_TOKEN=                     # id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=EPS

# ---- New Relic -------------------------------------------------------------
NEW_RELIC_API_KEY=NRAK-...          # USER key, not a licence/ingest key
NEW_RELIC_ACCOUNT_ID=1234567
NEW_RELIC_ENDPOINT=https://api.newrelic.com/graphql   # EU: api.eu.newrelic.com

# ---- Databricks ------------------------------------------------------------
DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...            # service principal with SELECT-only grants
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=orders

# ---- Behaviour -------------------------------------------------------------
TRIAGE_DRY_RUN=1                    # 1 = never write to Jira
TRIAGE_PLAYBOOK=config/playbooks/eps.yaml
TRIAGE_WEBHOOK_SECRET=
TRIAGE_TRIGGER_LABEL=auto-triage
